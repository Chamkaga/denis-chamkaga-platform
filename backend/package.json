{
  "name": "backend",
  "version": "1.0.0",
  "description": "Denis Chamkaga Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env DOTENV_CONFIG_QUIET=true tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "npm run test:phase5:all",
    "test:phase5:e2e": "tsx src/scripts/verify-phase5-e2e-pipeline.ts",
    "test:phase5:live": "tsx src/scripts/verify-phase5-step1-live-evidence.ts",
    "test:phase5:quality-gate": "tsx src/scripts/verify-phase5-step1-quality-gate.ts",
    "test:phase5:benchmark": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" tsx src/scripts/load-test-phase5-step2-empirical.ts",
    "test:phase5:step3": "tsx src/scripts/verify-phase5-step3-telemetry.ts",
    "test:phase5:step4": "tsx src/scripts/verify-phase5-step4-security.ts",
    "test:phase5:all": "npm run test:phase5:e2e && npm run test:phase5:live && npm run test:phase5:quality-gate && npm run test:phase5:benchmark && npm run test:phase5:step3 && npm run test:phase5:step4",
    "test:mary:conversational": "tsx src/scripts/test-mary-conversational-quality.ts",
    "test:mary:live": "tsx src/scripts/verify-mary-live-provider.ts",
    "test:security": "tsx src/scripts/test-security-regressions.ts",
    "test:mary:p1": "tsx src/scripts/test-mary-priority1-verification.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset --force",
    "db:setup": "prisma generate && prisma migrate dev --name init && npx tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "Denis Chamkaga",
  "license": "ISC",
  "dependencies": {
    "@dc/shared": "*",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.10.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.3",
    "openai": "^6.48.0",
    "pdfkit": "^0.19.1",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.7",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^10.0.0",
    "autocannon": "^8.0.0",
    "prisma": "^6.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
