generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  username            String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  roleId              String
  avatarUrl           String?
  isActive            Boolean              @default(true)
  mustChangePassword  Boolean              @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  auditLogs           AuditLog[]
  blogPosts           BlogPost[]
  client              Client?
  leads               Lead[]               @relation("AssignedLeads")
  notifications       Notification[]
  projects            Project[]
  role                Role                 @relation(fields: [roleId], references: [id])
  refreshTokens       RefreshToken[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  permissions Permission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  roleId    String
  resource  String
  action    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model Project {
  id                  String             @id @default(cuid())
  title               String
  slug                String             @unique
  description         String
  content             String
  thumbnailUrl        String?
  images              Json?
  techStack           Json
  category            String
  status              ProjectStatus
  liveUrl             String?
  githubUrl           String?
  gitlabUrl           String?
  startDate           DateTime?
  endDate             DateTime?
  isFeatured          Boolean            @default(false)
  displayOrder        Int                @default(0)
  createdById         String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  thumbnailAssetId    String?
  assignedTeam        Json?
  organizationId      String?
  progressPercent     Int                @default(0)
  budget              Decimal?           @db.Decimal(12, 2)
  contracts           Contract[]
  invoices            Invoice[]
  createdBy           User               @relation(fields: [createdById], references: [id])
  organization        Organization?      @relation(fields: [organizationId], references: [id])
  thumbnailAsset      DigitalAsset?      @relation("ProjectThumbnail", fields: [thumbnailAssetId], references: [id])
  quotations          Quotation[]
  workspaceMilestones ProjectMilestone[]
  workspaceTasks      ProjectTask[]
  assetFiles          ProjectAssetFile[]

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@index([organizationId])
  @@index([createdById])
  @@map("projects")
}

model Gallery {
  id           String        @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  thumbnailUrl String?
  category     String
  tags         Json?
  displayOrder Int           @default(0)
  isVisible    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  imageAssetId String?
  imageAsset   DigitalAsset? @relation("GalleryImage", fields: [imageAssetId], references: [id])

  @@index([category])
  @@map("gallery")
}

model Service {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String
  content      String
  icon         String?
  imageUrl     String?
  features     Json?
  technologies Json?
  pricingInfo  String?
  isActive     Boolean       @default(true)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  imageAssetId String?
  imageAsset   DigitalAsset? @relation("ServiceImage", fields: [imageAssetId], references: [id])

  @@index([slug])
  @@index([isActive])
  @@map("services")
}

model Experience {
  id             String        @id @default(cuid())
  company        String
  role           String
  description    String
  achievements   Json?
  companyLogoUrl String?
  location       String?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean       @default(false)
  displayOrder   Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  logoAssetId    String?
  logoAsset      DigitalAsset? @relation("ExperienceLogo", fields: [logoAssetId], references: [id])

  @@map("experiences")
}

model Education {
  id                 String        @id @default(cuid())
  institution        String
  degree             String
  fieldOfStudy       String
  description        String?
  institutionLogoUrl String?
  startDate          DateTime
  endDate            DateTime?
  grade              String?
  displayOrder       Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  logoAssetId        String?
  logoAsset          DigitalAsset? @relation("EducationLogo", fields: [logoAssetId], references: [id])

  @@map("education")
}

model Certificate {
  id            String        @id @default(cuid())
  title         String
  issuer        String
  description   String?
  imageUrl      String?
  credentialUrl String?
  credentialId  String?
  issueDate     DateTime
  expiryDate    DateTime?
  displayOrder  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  imageAssetId  String?
  imageAsset    DigitalAsset? @relation("CertificateImage", fields: [imageAssetId], references: [id])

  @@map("certificates")
}

model Testimonial {
  id                 String        @id @default(cuid())
  clientName         String
  clientTitle        String?
  clientCompany      String?
  clientPhotoUrl     String?
  content            String
  rating             Int
  isFeatured         Boolean       @default(false)
  isVisible          Boolean       @default(true)
  displayOrder       Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  clientPhotoAssetId String?
  clientPhotoAsset   DigitalAsset? @relation("TestimonialPhoto", fields: [clientPhotoAssetId], references: [id])

  @@map("testimonials")
}

model BlogPost {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  excerpt           String
  content           String
  coverImageUrl     String?
  categoryId        String
  authorId          String
  status            BlogPostStatus
  publishedAt       DateTime?
  scheduledAt       DateTime?
  readingTime       Int?
  viewCount         Int            @default(0)
  isFeatured        Boolean        @default(false)
  metaTitle         String?
  metaDescription   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  coverImageAssetId String?
  tags              BlogPostTag[]
  author            User           @relation(fields: [authorId], references: [id])
  category          Category       @relation(fields: [categoryId], references: [id])
  coverImageAsset   DigitalAsset?  @relation("BlogPostCover", fields: [coverImageAssetId], references: [id])

  @@index([slug])
  @@index([status, publishedAt])
  @@index([isFeatured])
  @@map("blog_posts")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  blogPosts   BlogPost[]

  @@index([slug])
  @@map("categories")
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  blogPosts BlogPostTag[]

  @@index([slug])
  @@map("tags")
}

model BlogPostTag {
  blogPostId String
  tagId      String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
  @@map("blog_post_tags")
}

model Lead {
  id                String          @id @default(cuid())
  name              String
  email             String?
  phone             String?
  company           String?
  source            LeadSource
  status            LeadStatus      @default(new)
  score             Int             @default(0)
  temperature       LeadTemperature @default(cold)
  requirements      String?
  budgetMentioned   Boolean         @default(false)
  timelineMentioned Boolean         @default(false)
  notes             String?
  assignedToId      String?
  convertedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  appointments      Appointment[]
  chatSessions      ChatSession[]
  consultations     Consultation[]
  callSessions      CallSession[]
  assignedTo        User?           @relation("AssignedLeads", fields: [assignedToId], references: [id])
  messages          Message[]

  @@index([status, temperature])
  @@index([createdAt])
  @@map("leads")
}

model Message {
  id        String    @id @default(cuid())
  leadId    String?
  name      String
  email     String
  phone     String?
  subject   String?
  content   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  lead      Lead?     @relation(fields: [leadId], references: [id])

  @@index([isRead])
  @@index([createdAt])
  @@map("messages")
}

model Appointment {
  id            String            @id @default(cuid())
  leadId        String?
  name          String
  email         String
  phone         String?
  purpose       String
  preferredDate DateTime
  preferredTime String
  status        AppointmentStatus @default(pending)
  notes         String?
  confirmedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lead          Lead?             @relation(fields: [leadId], references: [id])

  @@index([status])
  @@index([preferredDate])
  @@map("appointments")
}

model ChatSession {
  id            String            @id @default(cuid())
  visitorId     String?
  leadId        String?
  status        ChatSessionStatus @default(active)
  startedAt     DateTime          @default(now())
  endedAt       DateTime?
  messageCount  Int               @default(0)
  leadScore     Int               @default(0)
  metadata      Json?
  conversations AiConversation[]
  lead          Lead?             @relation(fields: [leadId], references: [id])

  @@index([status])
  @@index([visitorId])
  @@index([leadId])
  @@index([startedAt])
  @@map("chat_sessions")
}

model AiConversation {
  id         String      @id @default(cuid())
  sessionId  String
  role       MessageRole
  content    String
  intent     String?
  confidence Float?
  metadata   Json?
  createdAt  DateTime    @default(now())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("ai_conversations")
}

model InvestorRequest {
  id           String                @id @default(cuid())
  name         String
  email        String
  phone        String?
  company      String?
  interestType InvestorInterestType
  message      String
  status       InvestorRequestStatus @default(new)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@map("investor_requests")
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String
  category    String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@map("site_settings")
}

model AiKnowledgeItem {
  id             String               @id @default(cuid())
  title          String
  content        String
  category       String               @default("general")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdById    String?
  createdByName  String?
  indexStatus    String               @default("pending")
  keywords       String?
  lastIndexedAt  DateTime?
  status         String               @default("published")
  updatedById    String?
  updatedByName  String?
  duplicateScore Float?
  reviewDueAt    DateTime?
  source         String               @default("manual")
  version        Int                  @default(1)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  qualityScore   Int                  @default(0)
  relationships  Json?
  reviewInterval Int?
  tags           Json?
  validFrom      DateTime?
  validUntil     DateTime?
  versions       AiKnowledgeVersion[]

  @@index([category])
  @@index([status])
  @@index([source])
  @@map("ai_knowledge_items")
}

model AiKnowledgeVersion {
  id              String          @id @default(cuid())
  knowledgeItemId String
  version         Int
  title           String
  content         String
  keywords        String?
  status          String
  changedById     String?
  changedByName   String?
  changedAt       DateTime        @default(now())
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime?
  qualityScore    Int             @default(0)
  relationships   Json?
  reviewInterval  Int?
  tags            Json?
  validFrom       DateTime?
  validUntil      DateTime?
  knowledgeItem   AiKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
  @@map("ai_knowledge_versions")
}

model Visitor {
  id          String      @id @default(cuid())
  sessionId   String
  ipAddress   String?
  userAgent   String?
  referrer    String?
  country     String?
  city        String?
  firstVisit  DateTime    @default(now())
  lastVisit   DateTime    @default(now())
  visitCount  Int         @default(1)
  pagesViewed Json?
  analytics   Analytics[]

  @@index([sessionId])
  @@map("visitors")
}

model Analytics {
  id        String   @id @default(cuid())
  eventType String
  eventData Json?
  pagePath  String?
  visitorId String?
  sessionId String?
  createdAt DateTime @default(now())
  visitor   Visitor? @relation(fields: [visitorId], references: [id])

  @@index([eventType, createdAt])
  @@index([pagePath])
  @@map("analytics")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  device       String?
  ipAddress    String?
  userAgent    String?
  isTerminated Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Language {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  nativeName String
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("languages")
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("faqs")
}

model Tutorial {
  id           String   @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  provider     String // e.g. "youtube", "vimeo", "self-hosted"
  durationMin  Int      @default(0)
  thumbnailUrl String?
  isActive     Boolean  @default(true)
  resources    Json? // Stores future PDF notes, slides, and downloadable links
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tutorials")
}

model ScheduledProject {
  id                String                 @id @default(cuid())
  clientName        String
  projectTitle      String
  startDate         DateTime
  deadline          DateTime
  assignedDeveloper String?
  priority          ProjectPriority        @default(medium)
  progressPercent   Int                    @default(0)
  status            ScheduledProjectStatus @default(pending)
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status])
  @@index([deadline])
  @@map("scheduled_projects")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("active")
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletters")
}

model Campaign {
  id        String    @id @default(cuid())
  name      String
  type      String
  status    String    @default("planned")
  budget    Decimal?  @db.Decimal(14, 2)
  spend     Decimal?  @db.Decimal(14, 2)
  revenue   Decimal?  @db.Decimal(14, 2)
  metrics   Json?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("campaigns")
}

model ProductIdea {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  status      String   @default("ideation")
  impact      String?
  effort      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("product_ideas")
}

model RoadmapItem {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String
  quarter      String
  year         Int
  status       String   @default("planned")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("roadmap_items")
}

model PartnershipRequest {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String?
  organization      String?
  type              String
  collaborationArea String
  message           String
  status            String   @default("new")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("partnership_requests")
}

model AiPrompt {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  prompt    String
  category  String   @default("general")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_prompts")
}

model DigitalAsset {
  id                 String              @id @default(cuid())
  name               String
  originalName       String
  path               String
  url                String              @unique
  mimeType           String
  extension          String
  sizeBytes          Int
  width              Int?
  height             Int?
  duration           Float?
  altText            String?
  description        String?
  tags               String[]
  storageProvider    String              @default("local")
  usageCount         Int                 @default(0)
  uploadedBy         String?
  isPublic           Boolean             @default(false)
  isArchived         Boolean             @default(false)
  version            Int                 @default(1)
  checksum           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  folder             String              @default("Images")
  blogPostCovers     BlogPost[]          @relation("BlogPostCover")
  certificateImages  Certificate[]       @relation("CertificateImage")
  contracts          Contract[]
  educationLogos     Education[]         @relation("EducationLogo")
  experienceLogos    Experience[]        @relation("ExperienceLogo")
  galleryImages      Gallery[]           @relation("GalleryImage")
  projectThumbnails  Project[]           @relation("ProjectThumbnail")
  quotationResponses QuotationResponse[]
  serviceImages      Service[]           @relation("ServiceImage")
  sharedDocuments    SharedDocument[]
  testimonialPhotos  Testimonial[]       @relation("TestimonialPhoto")

  @@map("digital_assets")
}

model TenantConfig {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  vatNumber String?
  logoUrl   String?
  taxRate   Decimal  @default(18.00) @db.Decimal(5, 2)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_configs")
}

model DocumentSequence {
  id        String   @id @default(cuid())
  type      String   @unique
  prefix    String
  year      Int
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document_sequences")
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  website       String?
  status        String         @default("active")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clients       Client[]
  consultations Consultation[]
  contracts     Contract[]
  invoices      Invoice[]
  projects      Project[]
  quotations    Quotation[]

  @@map("organizations")
}

model Client {
  id              String           @id @default(cuid())
  organizationId  String
  firstName       String
  lastName        String
  email           String           @unique
  phone           String?
  role            String?
  status          String           @default("active")
  userId          String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id])
  messagesSent    PortalMessage[]
  sharedDocuments SharedDocument[]

  @@index([organizationId])
  @@map("clients")
}

model Consultation {
  id              String        @id @default(cuid())
  leadId          String?
  organizationId  String?
  title           String        @default("Consultation Meeting")
  scheduledAt     DateTime
  duration        Int           @default(60)
  status          String        @default("scheduled")
  notes           String?
  recommendations String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lead            Lead?         @relation(fields: [leadId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  quotations      Quotation[]

  @@index([organizationId])
  @@index([leadId])
  @@map("consultations")
}

model Quotation {
  id              String              @id @default(cuid())
  quotationNumber String
  version         Int                 @default(1)
  title           String
  organizationId  String
  consultationId  String?
  projectId       String?
  status          String              @default("draft")
  currency        String              @default("USD")
  subtotal        Decimal             @db.Decimal(12, 2)
  taxRate         Decimal             @default(0.00) @db.Decimal(5, 2)
  taxAmount       Decimal             @default(0.00) @db.Decimal(12, 2)
  discountRate    Decimal             @default(0.00) @db.Decimal(5, 2)
  discountAmount  Decimal             @default(0.00) @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  validUntil      DateTime
  notes           String?
  terms           String?
  approvedAt      DateTime?
  approvalNotes   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  invoices        Invoice[]
  items           QuotationItem[]
  responses       QuotationResponse[]
  consultation    Consultation?       @relation(fields: [consultationId], references: [id])
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?            @relation(fields: [projectId], references: [id])

  @@unique([quotationNumber, version])
  @@index([organizationId])
  @@index([consultationId])
  @@index([projectId])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  description String
  quantity    Decimal   @default(1.00) @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  subtotal    Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model Contract {
  id             String        @id @default(cuid())
  contractNumber String        @unique
  title          String
  organizationId String
  projectId      String?
  status         String        @default("draft")
  startDate      DateTime
  endDate        DateTime?
  value          Decimal?      @db.Decimal(12, 2)
  currency       String        @default("USD")
  notes          String?
  attachmentId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  attachment     DigitalAsset? @relation(fields: [attachmentId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id])

  @@map("contracts")
}

model Invoice {
  id                    String           @id @default(cuid())
  invoiceNumber         String           @unique
  organizationId        String
  quotationId           String?
  projectId             String?
  status                String           @default("draft")
  currency              String           @default("USD")
  subtotal              Decimal          @db.Decimal(12, 2)
  taxRate               Decimal          @default(0.00) @db.Decimal(5, 2)
  taxAmount             Decimal          @default(0.00) @db.Decimal(12, 2)
  discountRate          Decimal          @default(0.00) @db.Decimal(5, 2)
  discountAmount        Decimal          @default(0.00) @db.Decimal(12, 2)
  total                 Decimal          @db.Decimal(12, 2)
  issueDate             DateTime         @default(now())
  dueDate               DateTime
  paymentTerms          String?
  notes                 String?
  isRecurring           Boolean          @default(false)
  billingFrequency      String?
  nextBillingDate       DateTime?
  subscriptionReference String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  creditNotes           CreditNote[]
  history               InvoiceHistory[]
  items                 InvoiceItem[]
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project               Project?         @relation(fields: [projectId], references: [id])
  quotation             Quotation?       @relation(fields: [quotationId], references: [id])
  payments              Payment[]

  @@index([organizationId])
  @@index([projectId])
  @@index([quotationId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1.00) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model InvoiceHistory {
  id          String   @id @default(cuid())
  invoiceId   String
  action      String
  description String
  performedBy String?
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_histories")
}

model CreditNote {
  id               String   @id @default(cuid())
  creditNoteNumber String   @unique
  invoiceId        String
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("USD")
  reason           String
  status           String   @default("draft")
  issuedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("credit_notes")
}

model Payment {
  id                   String    @id @default(cuid())
  paymentNumber        String    @unique
  invoiceId            String? // Optional to support donation/consultation payments
  paymentType          String    @default("invoice") // invoice, support, consultation, etc.
  amount               Decimal   @db.Decimal(12, 2)
  currency             String    @default("TZS") // Tanzanian Shillings default
  gatewayName          String
  gatewayTransactionId String?   @unique
  gatewayPayload       Json?
  status               String    @default("successful")
  paymentDate          DateTime  @default(now())
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  customerEmail        String?
  customerPhone        String?
  exchangeRate         Decimal?  @db.Decimal(12, 4)
  fees                 Decimal?  @db.Decimal(12, 2)
  gatewayProvider      String?
  gatewayReference     String?
  paymentChannel       String?
  rawResponse          Json?
  verifiedAt           DateTime?
  invoice              Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipt              Receipt?

  @@index([invoiceId])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  paymentId     String   @unique
  status        String   @default("generated")
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model SharedDocument {
  id          String       @id @default(cuid())
  title       String
  description String?
  clientId    String
  assetId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  asset       DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("shared_documents")
}

model PortalMessage {
  id         String   @id @default(cuid())
  clientId   String?
  isAdmin    Boolean  @default(false)
  senderName String
  content    String
  createdAt  DateTime @default(now())
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("portal_messages")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model BusinessActivity {
  id          String   @id @default(cuid())
  action      String
  description String
  performedBy String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("business_activities")
}

model FinancialAuditLog {
  id             String   @id @default(cuid())
  action         String
  documentType   String
  documentId     String
  documentNumber String
  amount         Decimal? @db.Decimal(12, 2)
  currency       String?
  description    String
  performedBy    String?
  createdAt      DateTime @default(now())

  @@map("financial_audit_logs")
}

model DocumentAccess {
  id           String              @id @default(cuid())
  tokenHash    String              @unique
  documentType DocumentType
  documentId   String
  expiresAt    DateTime
  maxViews     Int                 @default(999)
  currentViews Int                 @default(0)
  lastViewedAt DateTime?
  revokedAt    DateTime?
  createdBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  logs         DocumentAccessLog[]

  @@index([tokenHash])
  @@map("document_access")
}

model DocumentAccessLog {
  id               String         @id @default(cuid())
  documentAccessId String
  viewedAt         DateTime       @default(now())
  ipAddress        String?
  userAgent        String?
  browser          String?
  device           String?
  os               String?
  country          String?
  city             String?
  viewedBeforePay  Boolean        @default(true)
  viewedAfterPay   Boolean        @default(false)
  documentAccess   DocumentAccess @relation(fields: [documentAccessId], references: [id], onDelete: Cascade)

  @@map("document_access_logs")
}

model QuotationResponse {
  id             String        @id @default(cuid())
  quotationId    String
  responseType   String
  notes          String?
  attachmentId   String?
  respondedAt    DateTime      @default(now())
  responderName  String?
  responderEmail String?
  attachment     DigitalAsset? @relation(fields: [attachmentId], references: [id])
  quotation      Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_responses")
}

model AiKnowledgeJob {
  id            String    @id @default(cuid())
  name          String    @unique
  status        String    @default("idle")
  processedDocs Int       @default(0)
  duration      Int       @default(0)
  retryCount    Int       @default(0)
  errorMessage  String?
  lastRun       DateTime  @default(now())
  nextRun       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("ai_knowledge_jobs")
}

model AiMemoryJob {
  id                  String    @id @default(cuid())
  sessionId           String
  conversationVersion Int
  userMessage         String
  assistantResponse   String
  idempotencyKey      String    @unique
  status              String    @default("pending")
  attempts            Int       @default(0)
  maxAttempts         Int       @default(3)
  errorMessage        String?
  availableAt         DateTime  @default(now())
  processedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([sessionId, conversationVersion])
  @@map("ai_memory_jobs")
}

model AiKnowledgeAuditLog {
  id        String   @id @default(cuid())
  action    String
  itemId    String?
  itemTitle String?
  trigger   String
  result    String   @default("success")
  details   String?
  createdAt DateTime @default(now())

  @@map("ai_knowledge_audit_logs")
}

