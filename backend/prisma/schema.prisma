model CallSession {
  id               String    @id @default(cuid())
  sessionId        String    @unique
  leadId           String?
  chatSessionId    String?
  startedAt        DateTime  @default(now())
  answeredAt       DateTime?
  endedAt          DateTime?
  callerName       String
  receiverName     String
  status           String // "ringing", "completed", "missed", "failed"
  durationSec      Int       @default(0)
  quality          String?
  packetLoss       Float?
  latency          Float?
  jitter           Float?
  audioLevel       Float?
  reconnectCount   Int       @default(0)
  recordingUrl     String?
  recordingStatus  String? // "none", "pending", "processing", "completed", "failed"
  transcript       String?
  transcriptStatus String? // "none", "pending", "processing", "completed", "failed"
  summary          String?
  sentiment        String?
  actionItems      String?
  leadScoreBefore  Int?
  leadScoreAfter   Int?
  denisNotes       String?
  nextAction       String?
  salesStage       String?
  customerBrief    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  events           CallLog[]
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([createdAt])
  @@map("call_sessions")
}

model CallLog {
  id            String      @id @default(cuid())
  callSessionId String
  event         String // "join", "leave", "mute", "unmute", "hold", "resume", "failed", "reconnected"
  detail        String?
  createdAt     DateTime    @default(now())
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)

  @@map("call_logs")
}

model InventoryItem {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  quantity    Int      @default(0)
  unitPrice   Decimal  @default(0.0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("inventory_items")
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  reference   String   @unique
  type        String // "credit", "debit"
  amount      Decimal  @db.Decimal(14, 2)
  description String
  invoiceId   String?
  createdAt   DateTime @default(now())

  @@map("financial_transactions")
}

enum SupportTier {
  SEED
  GROWTH
  VISION_BUILDER
  MISSION_CHAMPION
  CUSTOM
}

enum ContactCategory {
  VISITOR
  LEAD
  CLIENT
  VISION_SUPPORTER
  COLLABORATOR
  PARTNER
}

model SupporterProfile {
  id                  String                @id @default(cuid())
  fullName            String
  email               String                @unique
  phone               String?
  country             String                @default("Tanzania")
  tier                SupportTier           @default(SEED)
  supportType         String                @default("one_time") // one_time, recurring
  isRecurring         Boolean               @default(false)
  startDate           DateTime              @default(now())
  renewalDate         DateTime?
  expiryDate          DateTime?
  totalLifetimeAmount Decimal               @default(0.0) @db.Decimal(14, 2)
  currency            String                @default("TZS")
  paymentProvider     String                @default("DPO")
  paymentMethod       String?
  status              String                @default("active") // active, pending, cancelled, expired
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  contributions       SupportContribution[]

  @@index([email])
  @@index([tier])
  @@map("supporter_profiles")
}

model CollaboratorProfile {
  id               String   @id @default(cuid())
  fullName         String
  email            String   @unique
  phone            String?
  roleTitle        String // Developer, Designer, Writer, Researcher, Volunteer, Advisor, Business Partner
  skills           Json // Array of skill tags
  assignedProjects Json? // Array of assigned project IDs or names
  permissions      Json? // Granular permission keys
  status           String   @default("active") // active, pending, inactive
  activityLog      Json? // Activity history array
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([roleTitle])
  @@map("collaborator_profiles")
}

model SupportContribution {
  id                 String            @id @default(cuid())
  ctrId              String            @unique // Human-readable ID (e.g. CTR-2026-000001)
  receiptNo          String?           @unique // Human-readable Receipt ID (e.g. RCP-2026-000001)
  type               String            @default("Financial") // Financial, Collaboration, Partnership, Mentor, Volunteer, Research
  tier               SupportTier       @default(SEED)
  status             String            @default("Draft") // Draft, Pending, Redirected, Paid, Verified, Completed, Cancelled, Failed, Expired, Refunded, PendingReview
  supporterName      String?
  supporterEmail     String
  supporterPhone     String?
  country            String?           @default("Tanzania")
  notes              String?           @db.Text // Supporter message or collaboration goals
  amount             Decimal?          @db.Decimal(14, 2) // Nullable for non-financial contributions
  currency           String?           @default("TZS") // USD, TZS, KES, UGX, EUR, GBP
  exchangeRate       Decimal?          @default(1.0) @db.Decimal(18, 6) // Relative value vs base system currency (TZS)
  paymentProvider    String?           @default("DPO")
  paymentMethod      String? // Mobile Money, Card, Bank, etc.
  reference          String?           @unique // Payment gateway tracking token
  supportType        String?           @default("one_time") // one_time, recurring
  supporterProfileId String?
  createdAt          DateTime          @default(now())
  completedAt        DateTime?
  supporterProfile   SupporterProfile? @relation(fields: [supporterProfileId], references: [id], onDelete: SetNull)

  @@index([supporterProfileId])
  @@index([supporterEmail])
  @@map("support_contributions")
}

// ── Enterprise Finance ERP & Double-Entry Accounting Models ────────────────

enum AccountCategory {
  ASSET_CURRENT
  ASSET_FIXED
  LIABILITY_CURRENT
  LIABILITY_LONGTERM
  EQUITY
  REVENUE
  EXPENSE
}

enum CurrencyType {
  TZS
  USD
}

model ChartOfAccount {
  id           String          @id @default(cuid())
  accountCode  String          @unique // e.g., 1010 (Cash TZS), 1020 (Cash USD), 1200 (AR), 2000 (AP), 4000 (Revenue), 5000 (Expenses)
  name         String
  category     AccountCategory
  currency     CurrencyType    @default(TZS)
  balance      Decimal         @default(0.00) @db.Decimal(14, 2)
  isSystem     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  journalLines JournalLine[]

  @@map("chart_of_accounts")
}

model JournalEntry {
  id           String        @id @default(cuid())
  entryNumber  String        @unique // e.g., JRN-2026-00001
  date         DateTime      @default(now())
  description  String
  sourceModule String // CRM, Finance, Support, Project, Manual
  eventTrigger String? // InvoicePaid, SupporterContributionPaid, ExpenseRecorded, etc.
  reference    String?
  performedBy  String?       @default("WorkflowEngine")
  isReversal   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  lines        JournalLine[]

  @@index([date])
  @@index([sourceModule])
  @@map("journal_entries")
}

model JournalLine {
  id             String         @id @default(cuid())
  journalEntryId String
  accountId      String
  type           String // DEBIT or CREDIT
  amount         Decimal        @db.Decimal(14, 2)
  currency       CurrencyType   @default(TZS)
  exchangeRate   Decimal        @default(1.0000) @db.Decimal(12, 4)
  description    String?
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model BusinessExpense {
  id            String       @id @default(cuid())
  expenseNumber String       @unique // e.g., EXP-2026-00001
  category      String // Infrastructure, Salaries, Marketing, R&D, Travel, Utilities, Licenses
  vendor        String
  description   String
  amount        Decimal      @db.Decimal(14, 2)
  currency      CurrencyType @default(TZS)
  taxAmount     Decimal      @default(0.00) @db.Decimal(12, 2)
  projectId     String?
  department    String?      @default("Operations")
  status        String       @default("approved") // draft, pending_approval, approved, paid
  receiptUrl    String?
  expenseDate   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category])
  @@index([projectId])
  @@map("business_expenses")
}

// ── Phase 2: Advanced Project Workspace Models ──────────────────────────────

model ProjectTemplate {
  id          String                     @id @default(cuid())
  name        String                     @unique // e.g. Website Development, Mobile App, Brand Identity, Custom ERP
  category    String // Development, Design, AI Infrastructure, Marketing
  description String?
  isDefault   Boolean                    @default(false)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  milestones  ProjectMilestoneTemplate[]

  @@map("project_templates")
}

model ProjectMilestoneTemplate {
  id           String                @id @default(cuid())
  templateId   String
  title        String
  description  String?
  orderIndex   Int                   @default(0)
  durationDays Int                   @default(7)
  template     ProjectTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks        ProjectTaskTemplate[]

  @@map("project_milestone_templates")
}

model ProjectTaskTemplate {
  id                  String                   @id @default(cuid())
  milestoneTemplateId String
  title               String
  description         String?
  estimatedHours      Decimal                  @default(10.00) @db.Decimal(8, 2)
  department          String                   @default("Engineering")
  milestoneTemplate   ProjectMilestoneTemplate @relation(fields: [milestoneTemplateId], references: [id], onDelete: Cascade)

  @@map("project_task_templates")
}

model ProjectMilestone {
  id            String        @id @default(cuid())
  projectId     String
  title         String
  description   String?
  orderIndex    Int           @default(0)
  status        String        @default("planned") // planned, in_progress, completed, delayed
  plannedStart  DateTime?
  plannedEnd    DateTime?
  actualStart   DateTime?
  actualEnd     DateTime?
  completionPct Decimal       @default(0.00) @db.Decimal(5, 2)
  ownerName     String?
  budget        Decimal       @default(0.00) @db.Decimal(12, 2)
  cost          Decimal       @default(0.00) @db.Decimal(12, 2)
  riskLevel     String        @default("low") // low, medium, high
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks         ProjectTask[]

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectTask {
  id              String             @id @default(cuid())
  projectId       String
  milestoneId     String?
  title           String
  description     String?
  priority        String             @default("medium") // low, medium, high, urgent
  status          String             @default("todo") // todo, in_progress, in_review, done
  ownerName       String?
  assignedToEmail String?
  estimatedHours  Decimal            @default(0.00) @db.Decimal(8, 2)
  actualHours     Decimal            @default(0.00) @db.Decimal(8, 2)
  billableHours   Decimal            @default(0.00) @db.Decimal(8, 2)
  department      String             @default("Engineering")
  completionPct   Decimal            @default(0.00) @db.Decimal(5, 2)
  dueDate         DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone       ProjectMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  timeLogs        ProjectTimeLog[]
  files           ProjectAssetFile[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([assignedToEmail])
  @@map("project_tasks")
}

model ProjectTimeLog {
  id          String      @id @default(cuid())
  taskId      String
  loggedBy    String
  hours       Decimal     @db.Decimal(8, 2)
  description String?
  logDate     DateTime    @default(now())
  createdAt   DateTime    @default(now())
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("project_time_logs")
}

model ProjectAssetFile {
  id         String       @id @default(cuid())
  projectId  String
  taskId     String?
  fileName   String
  fileUrl    String
  fileType   String // PDF, Image, Video, SourceCode, Document, Archive
  fileSize   Int? // Bytes
  version    Int          @default(1)
  uploadedBy String
  visibility String       @default("internal") // internal, client_visible
  createdAt  DateTime     @default(now())
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_asset_files")
}

// ── Phase 3: Enterprise Marketing Automation Platform Models ────────────────

enum MarketingChannel {
  EMAIL
  WHATSAPP
  SMS
  PUSH
  IN_APP
  LINKEDIN
  FACEBOOK
  INSTAGRAM
}

enum BrandVoice {
  PROFESSIONAL
  FRIENDLY
  CORPORATE
  TECHNICAL
  EDUCATIONAL
  SALES
  EXECUTIVE
}

model ContactConsent {
  id                String   @id @default(cuid())
  contactEmail      String   @unique
  emailOptIn        Boolean  @default(true)
  smsOptIn          Boolean  @default(true)
  whatsappOptIn     Boolean  @default(true)
  newsletterSub     Boolean  @default(true)
  consentTimestamp  DateTime @default(now())
  unsubscribeReason String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([contactEmail])
  @@map("contact_consents")
}

model MarketingCampaign {
  id                String             @id @default(cuid())
  campaignNumber    String             @unique // e.g. CMP-2026-00001
  name              String
  type              String // Email, Newsletter, ProductLaunch, ServicePromo, EventInvite
  channels          MarketingChannel[]
  audienceRule      String // Dynamic CRM query rule JSON
  brandVoice        BrandVoice         @default(PROFESSIONAL)
  subject           String?
  content           String             @db.Text
  status            String             @default("draft") // draft, scheduled, active, completed, paused
  scheduledAt       DateTime?
  timezone          String             @default("Africa/Dar_es_Salaam")
  businessHoursOnly Boolean            @default(true)
  sentCount         Int                @default(0)
  openCount         Int                @default(0)
  clickCount        Int                @default(0)
  convertedCount    Int                @default(0)
  attributedRevenue Decimal            @default(0.00) @db.Decimal(14, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  journeys          CustomerJourney[]

  @@index([status])
  @@map("marketing_campaigns")
}

model CustomerJourney {
  id           String             @id @default(cuid())
  campaignId   String?
  name         String
  triggerEvent String // LeadQualified, ProjectCompleted, SupporterJoined
  status       String             @default("active")
  nodesJson    Json // Visual Workflow DAG nodes (Triggers, Delays, Conditions, Actions)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  campaign     MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@map("customer_journeys")
}

model MarketingAsset {
  id         String   @id @default(cuid())
  title      String
  assetType  String // Image, Video, PDF, CaseStudy, Logo, Template
  fileUrl    String
  fileSize   Int?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@map("marketing_assets")
}
