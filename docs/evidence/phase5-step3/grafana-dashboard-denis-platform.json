{
  "title": "Denis Business Platform - Enterprise Production Telemetry & SLA Dashboard",
  "tags": ["denis-platform", "mary-ai", "production-telemetry"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/sec)",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(denis_platform_http_requests_total[1m])) by (method, route)" }]
    },
    {
      "id": 2,
      "title": "Request Latency Percentiles (P50 / P95 / P99)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(denis_platform_http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(denis_platform_http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(denis_platform_http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx Error Rate (%)",
      "type": "gauge",
      "targets": [{ "expr": "sum(rate(denis_platform_http_requests_total{status_code=~\"5..\"}[1m])) / sum(rate(denis_platform_http_requests_total[1m])) * 100" }]
    },
    {
      "id": 4,
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "targets": [{ "expr": "rate(denis_platform_process_cpu_seconds_total[1m]) * 100" }]
    },
    {
      "id": 5,
      "title": "Memory Heap Used (MB)",
      "type": "timeseries",
      "targets": [{ "expr": "denis_platform_nodejs_heap_size_total_bytes / (1024 * 1024)" }]
    },
    {
      "id": 6,
      "title": "Event Loop Delay (ms)",
      "type": "timeseries",
      "targets": [{ "expr": "denis_platform_nodejs_eventloop_lag_seconds * 1000" }]
    },
    {
      "id": 7,
      "title": "PostgreSQL Active Connections",
      "type": "stat",
      "targets": [{ "expr": "denis_platform_postgres_active_connections" }]
    },
    {
      "id": 8,
      "title": "AI Orchestrator Processing Duration (seconds)",
      "type": "histogram",
      "targets": [{ "expr": "denis_platform_ai_orchestrator_latency_seconds_bucket" }]
    },
    {
      "id": 9,
      "title": "RAG Vector Retrieval Duration (seconds)",
      "type": "histogram",
      "targets": [{ "expr": "denis_platform_postgres_query_duration_seconds_bucket{query_type=\"vector_search\"}" }]
    }
  ]
}
