# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/denis_platform?schema=public"

# JWT Secrets
JWT_SECRET="your-secure-access-token-secret-at-least-32-chars"
JWT_REFRESH_SECRET="your-secure-refresh-token-secret-at-least-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
SESSION_CAPABILITY_SECRET="independent-session-capability-secret-at-least-32-chars"

# CORS Setup
FRONTEND_URL="http://localhost:5173"

# Mail SMTP Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
EMAIL_FROM="noreply@denischamkaga.com"

# Admin Account Credentials
ADMIN_EMAIL="admin@denischamkaga.com"
ADMIN_INITIAL_PASSWORD="SecureInitialPasswordChangeMe"

# Media Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760 # 10MB in bytes

# ─── Feature Flags & AI Settings ──────────────────────────────────────────────
AI_VISITOR_INTELLIGENCE=true
AI_MEMORY_ENGINE=true
AI_KNOWLEDGE_ENGINE=true
AI_LEAD_INTELLIGENCE=true
AI_ADMIN_COPILOT=false
PAYMENT_DPO_ENABLED=false
PAYMENT_DPO_SANDBOX=true
WEBRTC_ENABLED=false

# ─── LLM Provider Configuration ─────────────────────────────────────────────
# Sole supported LLM provider — Gemini has been removed from this codebase.
AI_PROVIDER="openai"
OPENAI_MODEL="<production-model>"
OPENAI_API_KEY="<your-openai-api-key>"

# ─── Email Provider ────────────────────────────────────────────────────────────
NOTIFICATION_PROVIDER="resend"
RESEND_API_KEY="<your-resend-api-key>"
SENDGRID_API_KEY="<your-sendgrid-api-key>"

# ─── Payments Config ──────────────────────────────────────────────────────────
# Leave PAYMENT_DPO_ENABLED=false until real, non-sandbox credentials are set.
# The server refuses to boot in production if enabled with sandbox=true or a
# missing token/service type.
PAYMENT_PROVIDER="dpo"
PAYMENT_DPO_ENABLED=false
PAYMENT_DPO_SANDBOX=false
DPO_COMPANY_TOKEN="your-dpo-company-token-here"
DPO_SERVICE_TYPE="3854"

FLW_PUBLIC_KEY="<your-flutterwave-public-key>"
FLW_SECRET_KEY="<your-flutterwave-secret-key>"
FLW_ENCRYPTION_KEY="<your-flutterwave-encryption-key>"
FLW_WEBHOOK_SECRET="<your-flutterwave-webhook-secret>"

# ─── CORS / cross-origin allowlist ─────────────────────────────────────────────
# Must exactly match the deployed frontend origin (no trailing slash).
CALENDLY_REDIRECT_URL="https://calendly.com/your-handle"
WHATSAPP_HANDOFF_PHONE="+255700000000"
